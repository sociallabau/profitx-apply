# Add these in Vercel -> Project -> Settings -> Environment Variables.

# Google Calendar: same values as the workshop funnel (profitx-funnel), so Gameplan Calls land in the same calendar.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_BUSY_CALENDAR_IDS=

# Kit (optional but recommended): adds each applicant with their answers, plus your tags
KIT_API_KEY=
KIT_TAG_APPLIED=
KIT_TAG_QUALIFIED=
KIT_TAG_UNQUALIFIED=
KIT_TAG_BOOKED=

# Optional: post each application / booking as JSON to Slack, Zapier, Make or GHL
APPLICATION_WEBHOOK_URL=

# Meta Conversions API (server-side Lead event). Pixel id also goes in index.html CONFIG.pixelId.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optional: paste from Events Manager > Test events, remove when done
# META_TEST_EVENT_CODE=

# Local testing only: sample times and fake bookings when Google isn't connected. Never set in production.
# DEMO_BOOKING=1
